---
import ArchiveList from '../../components/ArchiveList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';

const PAGE_SIZE = 20;
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
---

<BaseLayout title="所有文章" description={`zu1k 的 ${allPosts.length} 篇公开文章归档。`}>
  <ArchiveList
    posts={posts}
    title="所有文章"
    description={`从最近一次排查，到更早的技术实验与生活片段。这里是 ${allPosts.length} 篇文章的时间索引。`}
    totalCount={allPosts.length}
    page={1}
    totalPages={totalPages}
  />
</BaseLayout>
