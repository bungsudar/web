---
import ArchiveList from '../../components/ArchiveList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';

const PAGE_SIZE = 20;
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
---

<BaseLayout title="Blog" description={`Catatan Harian Sudar Blogger ${allPosts.length}`}>
  <ArchiveList
    posts={posts}
    title="Catatan Harian"
    description={`Ini adalah beberapa catatan harian sudar blogger,  cerita tentang kehidupan, pengalaman dan review. Berikut adalah garis waktu dari ${allPosts.length} artikel. `}
    totalCount={allPosts.length}
    page={1}
    totalPages={totalPages}
  />
</BaseLayout>
