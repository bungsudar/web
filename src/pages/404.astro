---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面未找到。" noindex={true}>
  <div class="not-found">
    <div class="not-found__signal" aria-hidden="true"><span>4</span><b>0</b><span>4</span></div>
    <div class="not-found__copy">
      <p>LOST IN THE INDEX</p>
      <h1>这一页没有留下坐标。</h1>
      <span>地址可能已经移动，也可能只是一次漂亮的拼写错误。</span>
      <nav aria-label="恢复导航">
        <a class="primary" href="/">回到首页 <Icon name="arrow" size={17} /></a>
        <a href="/search/"><Icon name="search" size={17} /> 搜索文章</a>
        <a href="/posts/">浏览归档</a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    width: min(calc(100% - 2rem), 72rem);
    min-height: calc(100vh - 6rem);
    margin: 0 auto;
    padding: 6rem clamp(0.5rem, 5vw, 4rem) 4rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .not-found::before {
    position: absolute;
    width: min(42rem, 80vw);
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background:
      radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 52%),
      radial-gradient(circle at 67% 68%, color-mix(in srgb, var(--accent-warm) 12%, transparent), transparent 48%);
  }

  .not-found__signal {
    position: absolute;
    inset: 50% auto auto 50%;
    display: flex;
    align-items: center;
    color: color-mix(in srgb, var(--text) 5%, transparent);
    font-family: var(--font-code);
    font-size: clamp(9rem, 29vw, 25rem);
    font-weight: 700;
    letter-spacing: -0.14em;
    line-height: 0.7;
    transform: translate(-50%, -55%);
    white-space: nowrap;
  }

  .not-found__signal b {
    color: color-mix(in srgb, var(--accent) 9%, transparent);
    font-weight: inherit;
  }

  .not-found__copy {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    text-align: center;
  }

  .not-found__copy > p {
    margin: 0 0 0.8rem;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.7rem, 7vw, 5.6rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .not-found__copy > span {
    margin-top: 1.2rem;
    display: block;
    color: var(--secondary);
    font-size: 0.88rem;
  }

  nav {
    margin-top: 1.6rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
  }

  nav a {
    min-height: 2.55rem;
    padding: 0.45rem 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.3rem;
    color: var(--text);
    font-size: 0.7rem;
    font-weight: 700;
  }

  nav a:hover { border-color: var(--accent); color: var(--accent); }
  nav .primary { border-color: var(--text); color: var(--page-bg); background: var(--text); }
  nav .primary:hover { color: #fff; background: var(--accent); }

  @media (max-width: 42rem) {
    .not-found { width: min(calc(100% - 1.25rem), 72rem); }
    nav { align-items: stretch; flex-direction: column; }
    nav a { justify-content: center; }
  }
</style>
