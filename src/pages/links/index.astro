---
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import friends from '../../data/friends';
import { siteIdentity } from '../../data/identity';

const siteExchangeInfo = `NAME: ${siteIdentity.name}\nBIO: ${siteIdentity.description}\nURL: ${siteIdentity.url}\nLOGO: ${siteIdentity.logo}`;
---

<BaseLayout title="Teman" description="Tetangga Sebelah Yang Hobi Ngeblog">
  <div class="wide-page links-page">
    <PageHero
      eyebrow="PEERS / OPEN WEB"
      title="Tetangga Sebelah"
      description="Beberapa Tetangga Sebelah Yang Memiliki Hobi Yang Sama Yaitu Menulis Artikel di Blog"
      mark={friends.length}
      compact
    >
      <div slot="aside" class="site-card">
        <span>informasi situs ini</span>
        <img src="/images/logo.jpg" alt="" width="48" height="48" />
        <div>
          <strong>{siteIdentity.name}</strong>
          <code>{siteIdentity.url}</code>
        </div>
        <p>{siteIdentity.description}</p>
        <button type="button" data-copy-site-info={siteExchangeInfo}>Salin Informasi</button>
      </div>
    </PageHero>

    <section class="friend-directory" aria-labelledby="friend-directory-title">
      <header>
        <div>
          <p>PEOPLE BEHIND THE LINKS</p>
          <h2 id="friend-directory-title">Media Patner</h2>
        </div>
        <span>{String(friends.length).padStart(2, '0')} FRIENDS</span>
      </header>

      <div class="friend-grid">
        {friends.map((friend, index) => (
          <a href={friend.url} rel="friend noopener" target="_blank">
            <span class="friend-index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
            <img src={friend.avatar} alt="" width="96" height="96" loading="lazy" />
            <span class="friend-copy">
              <strong>{friend.name}</strong>
              <small>{friend.description}</small>
              <code>{new URL(friend.url).hostname}</code>
            </span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </section>

    <section class="exchange-note" aria-labelledby="exchange-title">
      <p>EXCHANGE / Link Tautan</p>
      <h2 id="exchange-title">Mau Kirim Link?</h2>
      <div>
        <p>Kalian Yang Ingin Blog nya Menjadi Patner Sudar Blogger bisa kirim link nya ke email ini dan ikuti langkah - langkahnya.</p>
        <a href="mailto:admin@sudarblogger.com">admin@sudarblogger.com <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const copySiteButton = document.querySelector<HTMLButtonElement>('[data-copy-site-info]');
  copySiteButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copySiteButton.dataset.copySiteInfo ?? '');
      copySiteButton.textContent = '已复制';
      setTimeout(() => { copySiteButton.textContent = '复制站点信息'; }, 1600);
    } catch {
      copySiteButton.textContent = '复制失败';
    }
  });
</script>

<style>
  .site-card {
    display: grid;
    grid-template-columns: 2.7rem minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem 0.7rem;
  }

  .site-card > span {
    grid-column: 1 / -1;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .site-card img {
    width: 2.7rem;
    height: 2.7rem;
    margin: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  .site-card > div { min-width: 0; display: flex; flex-direction: column; gap: 0.05rem; }

  .site-card strong {
    color: var(--text);
    font-size: 1.08rem;
  }

  .site-card code {
    overflow: hidden;
    color: var(--secondary);
    font-family: var(--font-code);
    font-size: 0.56rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-card p {
    grid-column: 1 / -1;
    margin: 0.1rem 0 0;
    color: var(--secondary);
    font-family: var(--font-serif);
    font-size: 0.67rem;
    font-style: italic;
    line-height: 1.5;
  }

  .site-card button {
    grid-column: 1 / -1;
    width: max-content;
    margin-top: 0.45rem;
    padding: 0;
    border: 0;
    color: var(--accent);
    background: transparent;
    cursor: pointer;
    font-family: var(--font-code);
    font-size: 0.58rem;
  }

  .friend-directory {
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(0rem, 3vw, 2rem) 0;
  }

  .friend-directory > header {
    margin-bottom: 1.3rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .friend-directory > header p,
  .exchange-note > p {
    margin: 0 0 0.6rem;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .friend-directory h2,
  .exchange-note h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .friend-directory > header > span {
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  .friend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
  }

  .friend-grid > a {
    min-width: 0;
    min-height: 9rem;
    padding: 1rem;
    display: grid;
    grid-template-columns: auto 4.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    color: var(--text);
    transition: background-color 0.2s ease;
  }

  .friend-grid > a:hover { background: var(--surface-soft); }

  .friend-index {
    align-self: start;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.52rem;
  }

  .friend-grid img {
    width: 4.25rem;
    height: 4.25rem;
    margin: 0;
    border-radius: 50%;
    object-fit: cover;
    filter: saturate(0.75);
    transition: filter 0.25s ease, transform 0.3s ease;
  }

  .friend-grid > a:hover img {
    filter: saturate(1);
    transform: rotate(-2deg) scale(1.04);
  }

  .friend-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .friend-copy strong { font-size: 1.05rem; }

  .friend-copy small {
    margin-top: 0.2rem;
    overflow: hidden;
    color: var(--secondary);
    font-size: 0.68rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .friend-copy code {
    margin-top: 0.55rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.5rem;
  }

  .friend-grid :global(.icon) {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-0.25rem);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .friend-grid > a:hover :global(.icon) {
    opacity: 1;
    transform: translateX(0);
  }

  .exchange-note {
    margin: clamp(4rem, 8vw, 7rem) clamp(0rem, 3vw, 2rem) 0;
    padding: 1.5rem 0;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(16rem, 1.1fr);
    gap: 2rem 4rem;
    border-block: 1px solid var(--border-strong);
  }

  .exchange-note > p { grid-column: 1 / -1; margin-bottom: -1rem; }
  .exchange-note > div p { margin: 0; color: var(--secondary); font-size: 0.82rem; line-height: 1.7; }
  .exchange-note > div a { margin-top: 0.8rem; display: inline-block; color: var(--accent); font-family: var(--font-code); font-size: 0.68rem; }

  @media (max-width: 46rem) {
    .friend-directory { padding-top: 3.2rem; }
    .friend-grid { grid-template-columns: 1fr; }
    .friend-grid > a { min-height: 8rem; grid-template-columns: auto 3.6rem minmax(0, 1fr) auto; }
    .friend-grid img { width: 3.6rem; height: 3.6rem; }
    .exchange-note { grid-template-columns: 1fr; }
  }
</style>
