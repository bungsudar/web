---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { PROJECTS, PROJECT_CATEGORY_LABELS, PROJECT_FILTERS } from '../../data/projects';

const trendingCount = PROJECTS.filter((project) => project.trending).length;
const categoryCount = new Set(PROJECTS.map((project) => project.category)).size;
---

<BaseLayout title="我的项目" description="zu1k 的开源项目、开发工具与技术实验。">
  <div class="projects-page" data-projects>
    <section class="projects-hero" aria-labelledby="projects-title">
      <div class="projects-hero__copy">
        <p class="projects-kicker" data-no-select>PROJECT INDEX · 2017—NOW</p>
        <h1 id="projects-title" data-no-select>从一个问题，<br /><em>到一个可用的工具。</em></h1>
        <p class="projects-intro">
          我喜欢把真实遇到的问题做成小而锋利的工具。这里收录网络、系统、安全和开源生态中的长期作品与阶段性实验。
        </p>
        <div class="projects-actions" data-no-select>
          <a class="projects-action projects-action--primary" href="#project-explorer">
            浏览项目 <Icon name="arrow" size={17} />
          </a>
          <a class="projects-action" href="https://github.com/zu1k" rel="me noopener" target="_blank">
            <Icon name="github" size={17} /> GitHub
          </a>
        </div>
      </div>

      <dl class="projects-stats" aria-label="项目概览" data-no-select>
        <div>
          <dt>收录项目</dt>
          <dd>{PROJECTS.length}<small>个</small></dd>
        </div>
        <div>
          <dt>GitHub Trending</dt>
          <dd>{trendingCount}<small>次</small></dd>
        </div>
        <div>
          <dt>探索领域</dt>
          <dd>{categoryCount}<small>类</small></dd>
        </div>
      </dl>
    </section>

    <section class="project-explorer" id="project-explorer" aria-labelledby="project-explorer-title">
      <header class="project-explorer__header">
        <div>
          <p class="projects-kicker" data-no-select>BROWSE THE WORK</p>
          <h2 id="project-explorer-title">项目浏览器</h2>
        </div>
        <p>按名称、技术或领域快速筛选。按 <kbd>/</kbd> 可以随时开始搜索。</p>
      </header>

      <div class="project-toolbar">
        <label class="project-search" for="project-search-input">
          <Icon name="search" size={18} />
          <span class="visually-hidden">搜索项目</span>
          <input
            id="project-search-input"
            type="search"
            placeholder="搜索项目、技术或关键词…"
            autocomplete="off"
            data-project-search
          />
          <kbd aria-hidden="true">/</kbd>
        </label>

        <div class="project-filters" role="group" aria-label="项目类型">
          {PROJECT_FILTERS.map((filter, index) => (
            <button type="button" data-project-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <div class="project-results-meta">
        <output data-project-status aria-live="polite">显示全部 {PROJECTS.length} 个项目</output>
        <button type="button" data-project-clear hidden>清除筛选</button>
      </div>

      <div class="project-grid" data-project-grid>
        {PROJECTS.map((project, index) => {
          const primaryLink = project.links[0];
          const searchText = [
            project.name,
            project.summary,
            PROJECT_CATEGORY_LABELS[project.category],
            ...project.stack,
          ].join(' ').normalize('NFKC').toLocaleLowerCase('zh-CN');
          return (
            <article
              class:list={['project-card', { 'is-featured': project.featured, 'is-trending': project.trending }]}
              data-project-card
              data-category={project.category}
              data-trending={project.trending ? 'true' : 'false'}
              data-search={searchText}
            >
              <div class="project-card__topline">
                <span class="project-card__index" data-no-select>{String(index + 1).padStart(2, '0')}</span>
                {project.trending && <span class="project-card__trending">↗ GitHub Trending</span>}
              </div>

              <h3>
                <a
                  href={primaryLink.href}
                  target={primaryLink.href.startsWith('http') ? '_blank' : undefined}
                  rel={primaryLink.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {project.name}<Icon name="arrow" size={18} />
                </a>
              </h3>
              <p>{project.summary}</p>
              {project.highlight && <strong class="project-card__highlight">{project.highlight}</strong>}

              <ul class="project-card__stack" aria-label="技术标签">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>

              <footer>
                <span>{PROJECT_CATEGORY_LABELS[project.category]}</span>
                <nav aria-label={`${project.name} 链接`}>
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                      rel={link.href.startsWith('http') ? 'noopener' : undefined}
                    >
                      {link.label}<span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </nav>
              </footer>
            </article>
          );
        })}
      </div>

      <div class="project-empty" data-project-empty hidden>
        <span aria-hidden="true">∅</span>
        <h3>没有匹配的项目</h3>
        <p>换一个关键词，或者清除当前筛选条件。</p>
      </div>
      <noscript><p class="project-noscript">筛选功能需要 JavaScript；当前已展示全部项目。</p></noscript>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const searchInput = root?.querySelector<HTMLInputElement>('[data-project-search]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-project-card]') ?? [])];
  const filters = [...(root?.querySelectorAll<HTMLButtonElement>('[data-project-filter]') ?? [])];
  const status = root?.querySelector<HTMLOutputElement>('[data-project-status]');
  const clearButton = root?.querySelector<HTMLButtonElement>('[data-project-clear]');
  const empty = root?.querySelector<HTMLElement>('[data-project-empty]');
  const availableFilters = new Set(filters.map((button) => button.dataset.projectFilter ?? ''));
  const params = new URLSearchParams(location.search);
  let activeFilter = availableFilters.has(params.get('filter') ?? '') ? params.get('filter')! : 'all';
  let query = params.get('q') ?? '';

  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('zh-CN').trim();

  const renderProjects = () => {
    const normalizedQuery = normalize(query);
    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryMatch = activeFilter === 'all'
        || card.dataset.category === activeFilter
        || (activeFilter === 'trending' && card.dataset.trending === 'true');
      const queryMatch = !normalizedQuery || (card.dataset.search ?? '').includes(normalizedQuery);
      const visible = categoryMatch && queryMatch;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    filters.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.projectFilter === activeFilter));
    });

    if (status) {
      const qualifier = normalizedQuery ? `“${query.trim()}”` : filters.find((button) => button.dataset.projectFilter === activeFilter)?.textContent?.trim();
      status.textContent = activeFilter === 'all' && !normalizedQuery
        ? `显示全部 ${visibleCount} 个项目`
        : `${qualifier || '当前条件'} · ${visibleCount} 个结果`;
    }

    if (empty) empty.hidden = visibleCount !== 0;
    if (clearButton) clearButton.hidden = activeFilter === 'all' && !normalizedQuery;

    const nextUrl = new URL(location.href);
    activeFilter === 'all' ? nextUrl.searchParams.delete('filter') : nextUrl.searchParams.set('filter', activeFilter);
    normalizedQuery ? nextUrl.searchParams.set('q', query.trim()) : nextUrl.searchParams.delete('q');
    history.replaceState({}, '', nextUrl);
  };

  if (searchInput) searchInput.value = query;
  renderProjects();

  filters.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.projectFilter ?? 'all';
    renderProjects();
  }));

  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    renderProjects();
  });

  clearButton?.addEventListener('click', () => {
    activeFilter = 'all';
    query = '';
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    renderProjects();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement;
    if (event.key === '/' && !isTyping && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>

<style>
  .projects-page {
    --project-accent: #178caf;
    --project-warm: #d64d72;
    width: min(calc(100% - 2rem), 76rem);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .projects-hero {
    position: relative;
    min-height: min(38rem, calc(100vh - 3rem));
    padding: clamp(4rem, 9vw, 8rem) clamp(1.25rem, 5vw, 4.5rem) 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 7rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border-strong);
    isolation: isolate;
  }

  .projects-hero::before {
    position: absolute;
    z-index: -1;
    top: 7%;
    right: 3%;
    width: min(36rem, 55vw);
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background:
      radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--project-accent) 18%, transparent), transparent 52%),
      radial-gradient(circle at 68% 68%, color-mix(in srgb, var(--project-warm) 12%, transparent), transparent 48%);
    filter: blur(0.15rem);
  }

  .projects-hero::after {
    position: absolute;
    z-index: -1;
    right: clamp(1rem, 5vw, 4rem);
    bottom: -0.2em;
    content: "25";
    color: color-mix(in srgb, var(--text) 3.5%, transparent);
    font-family: var(--font-code);
    font-size: clamp(11rem, 28vw, 25rem);
    font-weight: 700;
    letter-spacing: -0.12em;
    line-height: 0.75;
    pointer-events: none;
  }

  .projects-kicker {
    margin: 0 0 1rem;
    color: var(--project-accent);
    font-family: var(--font-code);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .projects-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.8rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .projects-hero h1 em {
    display: inline-block;
    color: var(--secondary);
    font-weight: 400;
    white-space: nowrap;
  }

  .projects-intro {
    max-width: 39rem;
    margin: 1.7rem 0 0;
    color: var(--secondary);
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    line-height: 1.75;
  }

  .projects-actions {
    margin-top: 1.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .projects-action {
    min-height: 2.65rem;
    padding: 0.5rem 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.35rem;
    color: var(--text);
    background: color-mix(in srgb, var(--page-bg) 78%, transparent);
    font-size: 0.82rem;
    font-weight: 700;
    backdrop-filter: blur(10px);
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .projects-action:hover {
    border-color: var(--project-accent);
    color: var(--project-accent);
    transform: translateY(-0.1rem);
  }

  .projects-action--primary {
    border-color: var(--text);
    color: var(--page-bg);
    background: var(--text);
  }

  .projects-action--primary:hover {
    color: #fff;
    background: var(--project-accent);
  }

  .projects-stats {
    position: relative;
    z-index: 1;
    margin: 0;
    display: grid;
    border-top: 1px solid var(--border-strong);
  }

  .projects-stats div {
    padding: 0.9rem 0.2rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .projects-stats dt {
    color: var(--secondary);
    font-size: 0.74rem;
  }

  .projects-stats dd {
    margin: 0;
    font-family: var(--font-code);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
  }

  .projects-stats small {
    margin-left: 0.2rem;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 0.62rem;
    font-weight: 400;
  }

  .project-explorer {
    padding: clamp(3.5rem, 7vw, 6rem) clamp(0rem, 3vw, 2rem) 0;
    scroll-margin-top: 4rem;
  }

  .project-explorer__header {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .project-explorer__header h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .project-explorer__header > p {
    max-width: 28rem;
    margin: 0;
    color: var(--secondary);
    font-size: 0.76rem;
    text-align: right;
  }

  kbd {
    padding: 0.05rem 0.28rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.2rem;
    background: var(--surface-soft);
    box-shadow: inset 0 -1px 0 var(--border-strong);
    font-family: var(--font-code);
    font-size: 0.7rem;
  }

  .project-toolbar {
    position: sticky;
    z-index: 50;
    top: 3.5rem;
    padding: 0.65rem;
    border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--page-bg) 82%, transparent);
    box-shadow: 0 0.8rem 2.5rem rgb(0 0 0 / 5%);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .project-search {
    min-height: 2.75rem;
    padding: 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .project-search:focus-within {
    color: var(--project-accent);
  }

  .project-search input {
    min-width: 0;
    flex: 1;
    border: 0;
    outline: 0;
    color: var(--text);
    background: transparent;
    font-size: 0.86rem;
  }

  .project-search input::placeholder {
    color: var(--muted);
  }

  .project-filters {
    padding-top: 0.55rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .project-filters button {
    min-height: 2rem;
    padding: 0.3rem 0.65rem;
    border: 0;
    border-radius: 999px;
    color: var(--secondary);
    background: transparent;
    cursor: pointer;
    font-size: 0.7rem;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .project-filters button:hover {
    color: var(--text);
    background: var(--surface-soft);
  }

  .project-filters button[aria-pressed="true"] {
    color: #fff;
    background: var(--project-accent);
  }

  .project-results-meta {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.62rem;
  }

  .project-results-meta button {
    padding: 0;
    border: 0;
    color: var(--project-accent);
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .project-card {
    position: relative;
    min-height: 20rem;
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--page-raised) 94%, var(--surface-soft));
    box-shadow: 0 0 0 transparent;
    transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;
  }

  .project-card::after {
    position: absolute;
    right: -2.7rem;
    bottom: -3.5rem;
    width: 8rem;
    height: 8rem;
    border: 1px solid color-mix(in srgb, var(--project-accent) 16%, transparent);
    border-radius: 50%;
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: scale(0.7);
    transition: opacity 0.25s ease, transform 0.35s ease;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--project-accent) 50%, var(--border-strong));
    box-shadow: 0 0.9rem 2.5rem rgb(0 0 0 / 7%);
    transform: translateY(-0.2rem);
  }

  .project-card:hover::after {
    opacity: 1;
    transform: scale(1);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card.is-trending {
    border-top-color: var(--project-accent);
    border-top-width: 2px;
  }

  .project-card__topline {
    min-height: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
  }

  .project-card__trending {
    color: var(--project-accent);
    font-weight: 600;
  }

  .project-card h3 {
    margin: 1rem 0 0.75rem;
    font-size: 1.38rem;
    line-height: 1.15;
  }

  .project-card h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
  }

  .project-card h3 :global(svg) {
    color: var(--project-accent);
    opacity: 0;
    transform: translateX(-0.3rem);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .project-card:hover h3 :global(svg),
  .project-card h3 a:focus-visible :global(svg) {
    opacity: 1;
    transform: translateX(0);
  }

  .project-card > p {
    margin: 0;
    color: var(--secondary);
    font-size: 0.77rem;
    line-height: 1.65;
  }

  .project-card__highlight {
    margin-top: 0.9rem;
    color: var(--project-warm);
    font-family: var(--font-code);
    font-size: 0.66rem;
    font-weight: 600;
  }

  .project-card__stack {
    margin: auto 0 0.9rem;
    padding: 1.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
  }

  .project-card__stack li {
    padding: 0.18rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 0.2rem;
    color: var(--muted);
    background: var(--surface-soft);
    font-family: var(--font-code);
    font-size: 0.54rem;
  }

  .project-card footer {
    position: relative;
    z-index: 1;
    padding-top: 0.75rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.7rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.62rem;
  }

  .project-card footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.55rem;
  }

  .project-card footer a {
    min-height: 1.8rem;
    padding: 0 0.2rem;
    display: inline-flex;
    align-items: center;
    color: var(--secondary);
    border-radius: 0.2rem;
  }

  .project-card footer a:hover {
    color: var(--project-accent);
  }

  .project-card footer a:focus-visible {
    color: var(--project-accent);
    outline: 2px solid color-mix(in srgb, var(--project-accent) 58%, transparent);
    outline-offset: 2px;
  }

  .project-card footer a span {
    margin-left: 0.15rem;
  }

  .project-empty {
    min-height: 18rem;
    padding: 3rem 1rem;
    place-items: center;
    align-content: center;
    border-block: 1px solid var(--border-strong);
    text-align: center;
  }

  .project-empty:not([hidden]) {
    display: grid;
  }

  .project-empty > span {
    color: var(--project-accent);
    font-family: var(--font-code);
    font-size: 2rem;
  }

  .project-empty h3 {
    margin: 0.5rem 0 0;
  }

  .project-empty p,
  .project-noscript {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  :global(:root[data-theme="dark"]) .projects-page {
    --project-accent: #75c7df;
    --project-warm: #f18aab;
  }

  @media (min-width: 48.01rem) and (max-height: 56rem) {
    .projects-hero {
      min-height: min(34rem, calc(100svh - 3rem));
      padding-top: clamp(3rem, 8svh, 4rem);
      padding-bottom: 2.25rem;
    }

    .projects-hero h1 {
      font-size: clamp(2.7rem, min(6vw, 12svh), 5.2rem);
    }

    .projects-intro,
    .projects-actions {
      margin-top: 1.25rem;
    }
  }

  @media (max-width: 64rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .projects-page {
      width: min(calc(100% - 1.25rem), 76rem);
    }

    .projects-hero {
      min-height: auto;
      padding: 4.5rem 0.65rem 2.5rem;
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .projects-hero h1 {
      font-size: clamp(2.35rem, 10.5vw, 3rem);
    }

    .projects-hero h1 em {
      font-size: 0.92em;
    }

    .projects-hero::after {
      right: 0;
      font-size: 13rem;
    }

    .projects-stats {
