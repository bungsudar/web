---
export interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  mark?: string | number;
  compact?: boolean;
}

const { eyebrow, title, description, mark = '/', compact = false } = Astro.props;
---

<header class:list={['page-hero', { 'page-hero--compact': compact }]}>
  <div class="page-hero__copy">
    <p class="page-hero__eyebrow" data-no-select>{eyebrow}</p>
    <h1 data-no-select>{title}</h1>
    {description && <p class="page-hero__description">{description}</p>}
    <div class="page-hero__actions"><slot name="actions" /></div>
  </div>
  <div class="page-hero__aside"><slot name="aside" /></div>
  <span class="page-hero__mark" aria-hidden="true">{mark}</span>
</header>

<style>
  .page-hero {
    position: relative;
    min-height: 22rem;
    padding: clamp(3.8rem, 8vw, 6.5rem) clamp(0.5rem, 4vw, 3rem) 2.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(12rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 6rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border-strong);
    isolation: isolate;
  }

  .page-hero::before {
    position: absolute;
    z-index: -1;
    top: -35%;
    right: -4%;
    width: min(31rem, 52vw);
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background:
      radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 52%),
      radial-gradient(circle at 68% 68%, color-mix(in srgb, var(--accent-warm) 10%, transparent), transparent 48%);
  }

  .page-hero__copy,
  .page-hero__aside {
    position: relative;
    z-index: 1;
  }

  .page-hero__eyebrow {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-family: var(--font-code);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.7rem, 6vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .page-hero__description {
    max-width: 40rem;
    margin: 1.35rem 0 0;
    color: var(--secondary);
    font-size: clamp(0.9rem, 1.5vw, 1.02rem);
    line-height: 1.75;
  }

  .page-hero__actions:empty,
  .page-hero__aside:empty {
    display: none;
  }

  .page-hero__actions {
    margin-top: 1.4rem;
  }

  .page-hero__aside {
    padding: 0.85rem 0;
    border-block: 1px solid var(--border-strong);
    color: var(--secondary);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .page-hero__mark {
    position: absolute;
    z-index: -1;
    right: clamp(0.5rem, 4vw, 3rem);
    bottom: -0.12em;
    color: color-mix(in srgb, var(--text) 4%, transparent);
    font-family: var(--font-code);
    font-size: clamp(9rem, 22vw, 18rem);
    font-weight: 700;
    letter-spacing: -0.1em;
    line-height: 0.75;
    pointer-events: none;
  }

  .page-hero--compact {
    min-height: 18rem;
    padding-top: clamp(3.8rem, 7vw, 5.5rem);
  }

  .page-hero--compact h1 {
    font-size: clamp(2.5rem, 5vw, 4.6rem);
  }

  @media (min-width: 48.01rem) and (max-height: 56rem) {
    .page-hero {
      min-height: 20rem;
      padding-top: clamp(3.25rem, 8svh, 4.25rem);
      padding-bottom: 2rem;
    }

    .page-hero--compact {
      min-height: 16rem;
      padding-top: clamp(3.25rem, 8svh, 4.25rem);
    }
  }

  @media (max-width: 48rem) {
    .page-hero {
      min-height: auto;
      padding: 4.5rem 0.65rem 2.35rem;
      grid-template-columns: 1fr;
      gap: 1.7rem;
    }

    h1,
    .page-hero--compact h1 {
      max-width: none;
      font-size: clamp(2.35rem, 10.5vw, 3.4rem);
    }

    .page-hero__aside {
      max-width: 28rem;
    }

    .page-hero__mark {
      right: 0;
      font-size: 11rem;
    }
  }
</style>
