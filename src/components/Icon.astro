---
export interface Props {
  name: 'rss' | 'github' | 'twitter' | 'telegram' | 'mastodon' | 'mail' | 'search' | 'sun' | 'moon' | 'folder' | 'calendar' | 'clock' | 'user' | 'arrow';
  size?: number;
  strokeWidth?: number;
}

const { name, size = 20, strokeWidth = 1.8 } = Astro.props;
---

<svg
  class={`icon icon-${name}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'rss' && <><path d="M5 5a14 14 0 0 1 14 14" /><path d="M5 11a8 8 0 0 1 8 8" /><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" /></>}
  {name === 'github' && <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.2 3 5.4 5.4 0 0 0 19 0s-1.2-.4-4 1.6a13.8 13.8 0 0 0-7 0C5.2-.4 4 0 4 0a5.4 5.4 0 0 0-.2 3A5.8 5.8 0 0 0 2.2 7c0 5.8 3.5 7 6.8 7.4A4.8 4.8 0 0 0 8 18v4m0-3c-3 .9-3-1.5-4.2-2" />}
  {name === 'twitter' && <path d="M22 4.1c-.8.4-1.6.6-2.5.7A4.3 4.3 0 0 0 12 7.7v1A12.2 12.2 0 0 1 3.1 4.2s-4 9 5 13a13 13 0 0 1-7 2c9 5 20 0 20-11.5 0-.3 0-.7-.1-1A8.7 8.7 0 0 0 22 4.1Z" fill="currentColor" stroke="none" />}
  {name === 'telegram' && <><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" /><path d="m6.8 11.6 9.7-3.8c.45-.16.84.1.7.73l-1.66 7.83c-.12.56-.45.7-.92.44l-2.52-1.86-1.22 1.17c-.13.13-.25.25-.5.25l.18-2.57 4.68-4.23c.2-.18-.05-.28-.32-.1l-5.78 3.64-2.49-.78c-.54-.17-.55-.54.12-.8Z" fill="var(--page-bg, #fff)" stroke="none" /></>}
  {name === 'mastodon' && <path d="M20.5 7.2c-.3-2.3-2.3-4.1-4.7-4.4A31 31 0 0 0 12 2.6c-1.3 0-2.6.1-3.8.2-2.4.3-4.4 2.1-4.7 4.4a27 27 0 0 0 .1 7.5c.4 2.3 2.5 4 4.9 4.2 1.1.1 2.2.1 3.3 0 0 0 .1.9 1.7 2.4 2.1 2.2.4 4.3.1 6.2-.8l-.1-2.4c-1.7.8-3.5 1.1-5.3.8-1.5-.2-2.1-1.3-2.2-2.1 2 .5 4.1.5 6.1.2 2.4-.4 4.4-2.2 4.7-4.6.2-2.1.2-4.2-.1-6.2Zm-3.1 6.2h-2.6V9.1c0-.9-.4-1.4-1.1-1.4-.8 0-1.2.6-1.2 1.7v2.4H10V9.4c0-1.1-.4-1.7-1.2-1.7-.7 0-1.1.5-1.1 1.4v4.3H5.1V9c0-2.3 1.2-3.5 3.4-3.5 1.1 0 2 .4 2.7 1.2l.8 1 .8-1c.7-.8 1.6-1.2 2.7-1.2 2.2 0 3.4 1.2 3.4 3.5v4.4Z" fill="currentColor" stroke="none" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'moon' && <path d="M20.5 15.3A8.6 8.6 0 0 1 8.7 3.5 8.7 8.7 0 1 0 20.5 15.3Z" />}
  {name === 'folder' && <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2h8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z" fill="currentColor" stroke="none" />}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></>}
  {name === 'arrow' && <path d="m5 12 14 0m-5-5 5 5-5 5" />}
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.16em;
  }
</style>
