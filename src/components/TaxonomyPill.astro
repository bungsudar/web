---
export interface Props {
  label: string;
  href?: string;
  count?: number;
  kind?: 'tag' | 'category' | 'plain';
}

const { label, href, count, kind = 'tag' } = Astro.props;
const prefix = kind === 'tag' ? '#' : kind === 'category' ? '§' : '';
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['taxonomy-pill', `taxonomy-pill--${kind}`]} href={href}>
  <span aria-hidden="true">{prefix}</span>{label}{typeof count === 'number' && <small>{count}</small>}
</Tag>

<style>
  .taxonomy-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    padding: 0.15rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 520;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 130ms ease,
      border-color 130ms ease;
  }

  .taxonomy-pill > span {
    color: var(--signal);
  }

  .taxonomy-pill small {
    margin-left: 0.2rem;
    color: var(--ink-faint);
    font-size: 0.58rem;
    font-weight: 500;
  }

  a.taxonomy-pill:hover {
    color: var(--ink);
    border-color: var(--signal);
  }
</style>
