---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <aside class="article-toc" aria-label="文章目录" data-article-toc>
    <div class="article-toc__rail">
      <header>
        <span>ON THIS PAGE</span>
        <output aria-live="polite"><b data-toc-current>01</b> / {String(items.length).padStart(2, '0')}</output>
      </header>
      <nav data-toc aria-label="文章目录">
        <ol>
          {items.map((heading, index) => (
            <li class:list={{ 'is-subsection': heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-index={index + 1}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <details class="article-toc__inline">
      <summary>
        <span>文章目录</span>
        <span class="article-toc__inline-status"><b data-toc-current>01</b> / {String(items.length).padStart(2, '0')}</span>
      </summary>
      <nav data-toc aria-label="文章目录">
        <ol>
          {items.map((heading, index) => (
            <li class:list={{ 'is-subsection': heading.depth === 3 }}>
              <a href={`#${heading.slug}`} data-toc-index={index + 1}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

<script>
  const roots = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
  const links = roots.flatMap((root) => [...root.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]);
  const sectionIds = [...new Set(links.map((link) => decodeURIComponent(link.hash.slice(1))))];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((node): node is HTMLElement => Boolean(node));
  const counters = [...document.querySelectorAll<HTMLElement>('[data-toc-current]')];

  const setActive = (id: string) => {
    const activeIndex = Math.max(0, sectionIds.indexOf(id));
    links.forEach((link) => {
      const active = decodeURIComponent(link.hash.slice(1)) === id;
      link.toggleAttribute('data-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    counters.forEach((counter) => {
      counter.textContent = String(activeIndex + 1).padStart(2, '0');
    });
  };

  let scheduled = false;
  const updateActiveSection = () => {
    scheduled = false;
    if (sections.length === 0) return;
    const readingLine = Math.min(window.innerHeight * 0.28, 220);
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) current = section;
      else break;
    }
    setActive(current.id);
  };

  const scheduleUpdate = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateActiveSection);
  };

  if (sections.length > 0) {
    updateActiveSection();
    addEventListener('scroll', scheduleUpdate, { passive: true });
    addEventListener('resize', scheduleUpdate, { passive: true });
  }

  links.forEach((link) => link.addEventListener('click', () => {
    const inline = link.closest('details');
    if (inline instanceof HTMLDetailsElement) inline.open = false;
  }));
</script>

<style>
  .article-toc__rail {
    position: fixed;
    z-index: 35;
    top: 6.3rem;
    left: max(1.25rem, calc((100vw - min(60vw, var(--page-width))) / 2 - 12rem));
    width: 10.5rem;
    max-height: calc(100vh - 8rem);
    overflow: hidden;
  }

  .article-toc__rail header {
    margin-bottom: 0.7rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-family: var(--font-code);
    font-size: 0.55rem;
    letter-spacing: 0.09em;
  }

  .article-toc__rail output {
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .article-toc__rail output b {
    color: var(--text);
    font-weight: 600;
  }

  nav {
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  nav::-webkit-scrollbar {
    display: none;
  }

  ol {
    margin: 0;
    padding: 0 0 0 0.75rem;
    border-left: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    list-style: none;
  }

  li {
    position: relative;
    margin: 0;
  }

  li.is-subsection a {
    padding-left: 0.65rem;
    font-size: 0.68rem;
    opacity: 0.82;
  }

  a {
    position: relative;
    padding: 0.3rem 0.2rem;
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  a::before {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: -0.8rem;
    width: 2px;
    border-radius: 999px;
    content: "";
    background: var(--link-hover);
    opacity: 0;
    transform: scaleY(0.35);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  a:hover {
    color: var(--text);
  }

  a[data-active] {
    color: var(--text);
    font-weight: 600;
    transform: translateX(0.2rem);
  }

  a[data-active]::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .article-toc__inline {
    display: none;
  }

  @media (max-width: 75rem) {
    .article-toc__rail {
      display: none;
    }

    .article-toc__inline {
      margin: 1.2rem 0 1.5rem;
      display: block;
      border-block: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
    }

    .article-toc__inline summary {
      min-height: 2.8rem;
      padding: 0 0.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--text);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 700;
      list-style: none;
    }

    .article-toc__inline summary::-webkit-details-marker {
      display: none;
    }

    .article-toc__inline summary::after {
      width: 1.25rem;
      height: 1.25rem;
      display: grid;
      place-items: center;
      border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
      border-radius: 50%;
      content: "+";
      font-family: var(--font-code);
      font-size: 0.75rem;
      font-weight: 400;
    }

    .article-toc__inline[open] summary::after {
      content: "−";
    }

    .article-toc__inline-status {
      margin-left: auto;
      color: var(--muted);
      font-family: var(--font-code);
      font-size: 0.62rem;
      font-weight: 400;
      letter-spacing: 0.04em;
    }

    .article-toc__inline nav {
      max-height: min(22rem, 55vh);
      padding: 0.2rem 0 0.75rem;
    }

    .article-toc__inline ol {
      margin-left: 0.2rem;
    }

    .article-toc__inline a {
      padding-block: 0.38rem;
      font-size: 0.82rem;
    }

    .article-toc__inline li.is-subsection a {
      font-size: 0.76rem;
    }
  }
</style>
