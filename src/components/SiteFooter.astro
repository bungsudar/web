---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-line">
    <span aria-hidden="true">©</span>{' '}{SITE.since} - {year}{' '}
    <a href={SITE.url}>{SITE.author}</a>{' '}
    <span aria-hidden="true">|</span>{' '}
    <a rel="license external nofollow noopener" href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank">CC BY-NC 4.0</a>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    min-height: 1.25rem;
    padding: 1rem 0;
    color: var(--text);
    line-height: 1.25rem;
    text-align: center;
  }

  .footer-line {
    width: 100%;
    font-size: 0.875rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--link-hover);
  }
</style>
